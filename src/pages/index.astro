---
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Archive d'exercices de concours (2ème prépa MP) filtrables par chapitre."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Concours archive</title>
  </head>
  <body class="min-h-screen bg-surface font-sans text-ink antialiased">
    <main
      class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center px-4 text-center"
    >
      <h1 class="text-3xl font-semibold">Concours archive</h1>
      <p class="mt-3 text-ink-muted">
        Bientôt&nbsp;: filtrez les exercices de concours français, tunisiens et
        marocains par chapitre du programme MP.
      </p>
    </main>
  </body>
</html>
