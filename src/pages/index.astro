---
import '../styles/global.css';
import { dataset } from '../data/dataset';
import { FLAGS } from '../lib/format';
import type { Country } from '../lib/types';

const chapitres = [...dataset.chapitres].sort((a, b) => a.order - b.order);
const domains = [...new Set(chapitres.map((c) => c.domain))];

// Refinement options, derived from the papers actually in the dataset so the
// controls only ever offer values that can return a result.
const COUNTRY_LABELS: Record<Country, string> = { FR: 'France', TN: 'Tunisie', MA: 'Maroc' };
const presentCountries = new Set(dataset.papers.map((p) => p.country));
const countries = (Object.keys(COUNTRY_LABELS) as Country[])
  .filter((code) => presentCountries.has(code))
  .map((code) => ({ code, label: COUNTRY_LABELS[code] }));
const examBrands = [...new Set(dataset.papers.map((p) => p.examBrand))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
const years = [...new Set(dataset.papers.map((p) => p.year))].sort((a, b) => b - a);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Archive d'exercices de concours (2ème prépa MP) filtrables par chapitre."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Concours archive</title>
  </head>
  <body class="min-h-screen bg-surface font-sans text-ink antialiased">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-6 md:flex-row md:gap-8 md:py-8">
      <!-- Sidebar: the chapitre front door -->
      <aside class="w-full shrink-0 md:w-72">
        <h1 class="text-xl font-semibold">Concours archive</h1>
        <nav class="mt-6" aria-label="Chapitres">
          <button type="button" class="chapitre-btn" data-chapitre-reset aria-pressed="true">
            Tous les chapitres
          </button>
          {
            domains.map((domain) => (
              <div class="mt-6">
                <p class="domain-label">{domain}</p>
                <div class="mt-2 flex flex-col gap-1">
                  {chapitres
                    .filter((c) => c.domain === domain)
                    .map((c) => (
                      <button
                        type="button"
                        class="chapitre-btn"
                        data-chapitre-id={c.id}
                        aria-pressed="false"
                      >
                        {c.name}
                      </button>
                    ))}
                </div>
              </div>
            ))
          }
        </nav>

        <!-- Refinement filters: stackable AND on top of the chapitre -->
        <div class="filter-bar" role="group" aria-label="Filtres">
          <p class="domain-label">Affiner</p>
          <div class="filter-field">
            <label for="filter-country">Pays</label>
            <select id="filter-country" class="filter-select">
              <option value="">Tous</option>
              {countries.map((c) => <option value={c.code}>{FLAGS[c.code]} {c.label}</option>)}
            </select>
          </div>
          <div class="filter-field">
            <label for="filter-brand">Concours</label>
            <select id="filter-brand" class="filter-select">
              <option value="">Tous</option>
              {examBrands.map((b) => <option value={b}>{b}</option>)}
            </select>
          </div>
          <div class="filter-field">
            <label for="filter-year">Année</label>
            <select id="filter-year" class="filter-select">
              <option value="">Toutes</option>
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>
          <button type="button" id="filter-reset" class="filter-reset">
            Réinitialiser les filtres
          </button>
        </div>
      </aside>

      <!-- Main column: results -->
      <main class="min-w-0 flex-1">
        <h2 id="heading" class="text-xl font-semibold">Tous les exercices</h2>
        <p id="count" class="mt-1 text-ink-muted"></p>
        <ul id="results" class="mt-4 overflow-hidden rounded-md border border-border bg-surface-raised"></ul>
        <noscript>
          <p class="empty-state">
            Ce site a besoin de JavaScript pour filtrer les exercices.
          </p>
        </noscript>
      </main>
    </div>

    <script>
      import { dataset } from '../data/dataset';
      import { filterExercises } from '../lib/filter';
      import { FLAGS, exerciseCount } from '../lib/format';
      import { pdfHref } from '../lib/pdf';
      import type { Country, Exercise, FilterCriteria } from '../lib/types';

      const chapitreById = new Map(dataset.chapitres.map((c) => [c.id, c]));
      const paperById = new Map(dataset.papers.map((p) => [p.id, p]));

      const heading = document.getElementById('heading')!;
      const countEl = document.getElementById('count')!;
      const results = document.getElementById('results')!;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-chapitre-id], [data-chapitre-reset]'),
      );
      const countrySel = document.getElementById('filter-country') as HTMLSelectElement;
      const brandSel = document.getElementById('filter-brand') as HTMLSelectElement;
      const yearSel = document.getElementById('filter-year') as HTMLSelectElement;
      const resetBtn = document.getElementById('filter-reset') as HTMLButtonElement;

      let selectedChapterId: string | null = null;

      // Assemble the active criteria from the chapitre front door plus the
      // optional refinement selects; an empty select value means "no constraint".
      function currentCriteria(): FilterCriteria {
        const criteria: FilterCriteria = {};
        if (selectedChapterId) criteria.chapterId = selectedChapterId;
        if (countrySel.value) criteria.country = countrySel.value as Country;
        if (brandSel.value) criteria.examBrand = brandSel.value;
        if (yearSel.value) criteria.year = Number(yearSel.value);
        return criteria;
      }

      function chip(chapterId: string, isPrimary: boolean): HTMLElement {
        const el = document.createElement('span');
        el.className = isPrimary ? 'chip chip--primary' : 'chip';
        el.textContent = chapitreById.get(chapterId)?.name ?? chapterId;
        return el;
      }

      function row(ex: Exercise): HTMLLIElement {
        const paper = paperById.get(ex.paperId);

        const li = document.createElement('li');
        li.className = 'result-row';

        const left = document.createElement('div');

        const title = document.createElement('div');
        title.className = 'result-row__title';
        title.textContent = ex.label;
        left.appendChild(title);

        if (paper) {
          const meta = document.createElement('div');
          meta.className = 'result-row__meta';
          meta.append(`${FLAGS[paper.country]} ${paper.examBrand} · `);
          const year = document.createElement('span');
          year.className = 'tnum';
          year.textContent = String(paper.year);
          meta.appendChild(year);
          left.appendChild(meta);
        }

        const chips = document.createElement('div');
        chips.className = 'result-row__chips';
        for (const id of ex.chapterIds) {
          chips.appendChild(chip(id, id === ex.primaryChapterId));
        }
        left.appendChild(chips);

        li.appendChild(left);

        // "Ouvrir" opens the parent paper's PDF at the exercise's start page in
        // a new tab. Omitted entirely when there's no usable path, so a missing
        // pdfPath degrades to no action rather than a broken link.
        const href = paper ? pdfHref(paper.pdfPath, ex.pageStart) : null;
        if (href) {
          const open = document.createElement('a');
          open.className = 'btn btn--secondary';
          open.href = href;
          open.target = '_blank';
          open.rel = 'noopener noreferrer';
          open.textContent = 'Ouvrir';
          li.appendChild(open);
        }
        return li;
      }

      function render(): void {
        const matches = filterExercises(dataset, currentCriteria());

        heading.textContent = selectedChapterId
          ? (chapitreById.get(selectedChapterId)?.name ?? 'Exercices')
          : 'Tous les exercices';
        countEl.textContent = exerciseCount(matches.length);

        results.replaceChildren();
        if (matches.length === 0) {
          const li = document.createElement('li');
          li.className = 'empty-state';
          li.textContent = 'Aucun exercice.';
          results.appendChild(li);
          return;
        }
        for (const ex of matches) results.appendChild(row(ex));
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          selectedChapterId = btn.dataset.chapitreId ?? null;
          for (const b of buttons) {
            const active = b === btn;
            b.setAttribute('aria-pressed', String(active));
          }
          render();
        });
      }

      for (const sel of [countrySel, brandSel, yearSel]) {
        sel.addEventListener('change', render);
      }

      // Reset returns to the chapitre-only view: clear refinements, keep the chapitre.
      resetBtn.addEventListener('click', () => {
        countrySel.value = '';
        brandSel.value = '';
        yearSel.value = '';
        render();
      });

      render();
    </script>
  </body>
</html>
