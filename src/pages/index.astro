---
import '../styles/global.css';
import { archive } from '../data/archive';
import { createArchiveView } from '../lib/archive-view';

// What the student can choose from — the chapitre groups and the refinement
// options — comes from the archive view, so the page renders it and decides
// none of it.
const { chapitreGroups, refinements } = createArchiveView(archive).controls();

// Masthead facts. Counted off the dataset so they can never drift from what the
// archive actually holds.
const exerciseTotal = archive.exercises.length;
const paperTotal = archive.papers.length;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Archive d'exercices de concours (2ème prépa MP) filtrables par chapitre."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Concours archive — exercices de concours par chapitre</title>
  </head>
  <body class="flex min-h-screen flex-col bg-surface font-sans text-ink antialiased">
    <header class="masthead">
      <div class="masthead__inner mx-auto max-w-6xl px-4 py-5 md:py-6">
        <div class="masthead__brand">
          <img class="masthead__mark" src="/logo.png" alt="" width="128" height="114" />
          <div class="min-w-0">
            <h1 class="masthead__title">Concours archive</h1>
            <p class="masthead__tagline">
              Exercices de concours classés par chapitre — programme tunisien 2ème prépa MP
            </p>
          </div>
        </div>
        <dl class="masthead__stats">
          <div class="masthead__stat">
            <dt class="masthead__stat-label">Exercices</dt>
            <dd class="masthead__stat-value">{exerciseTotal}</dd>
          </div>
          <div class="masthead__stat">
            <dt class="masthead__stat-label">Épreuves</dt>
            <dd class="masthead__stat-value">{paperTotal}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 md:py-8">
      <!-- Mobile only: the sidebar collapses into a sheet behind this toggle -->
      <button
        type="button"
        id="sidebar-toggle"
        class="btn btn--secondary sidebar-toggle mb-4"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        Chapitres &amp; filtres
      </button>

      <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-8">
        <!-- Sidebar: the chapitre front door (a collapsible sheet on mobile) -->
        <aside
          id="sidebar"
          class="sidebar panel w-full shrink-0 p-4 md:w-72"
          data-open="false"
          aria-label="Chapitres et filtres"
        >
          <nav aria-label="Chapitres">
            <button type="button" class="chapitre-btn" data-chapitre-reset aria-pressed="true">
              Tous les chapitres
            </button>
            {
              chapitreGroups.map(({ domain, chapitres }) => (
                <div class="mt-6">
                  <p class="domain-label">{domain}</p>
                  <div class="mt-2 flex flex-col gap-1">
                    {chapitres.map((c) => (
                      <button
                        type="button"
                        class="chapitre-btn"
                        data-chapitre-id={c.id}
                        aria-pressed="false"
                      >
                        {c.name}
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }
          </nav>

          <!-- Refinement filters: stackable AND on top of the chapitre -->
          <div class="filter-bar" role="group" aria-label="Filtres">
            <p class="domain-label">Affiner</p>
            <div class="filter-field">
              <label for="filter-country">Pays</label>
              <select id="filter-country" class="filter-select">
                <option value="">Tous</option>
                {refinements.country.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label for="filter-brand">Concours</label>
              <select id="filter-brand" class="filter-select">
                <option value="">Tous</option>
                {refinements.examBrand.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label for="filter-year">Année</label>
              <select id="filter-year" class="filter-select">
                <option value="">Toutes</option>
                {refinements.year.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            </div>
            <button type="button" id="filter-reset" class="btn btn--secondary self-start">
              Réinitialiser les filtres
            </button>
          </div>
      </aside>

      <!-- Main column: results -->
      <main class="min-w-0 flex-1">
        <section class="panel overflow-hidden">
          <div class="panel__header">
            <h2 id="heading" class="panel__title">Tous les exercices</h2>
            <p id="count" class="panel__count"></p>
          </div>
          <ul id="results"></ul>
          <noscript>
            <p class="empty-state">Ce site a besoin de JavaScript pour filtrer les exercices.</p>
          </noscript>
        </section>
      </main>
      </div>
    </div>

    <footer class="site-footer">
      <div class="mx-auto max-w-6xl px-4 py-6">
        Concours archive — archives des concours de France, Tunisie et Maroc,
        remises dans les chapitres du programme tunisien MP.
      </div>
    </footer>

    <script>
      // The adapter: every line here either turns an event into an archive-view
      // command or paints view() into the DOM. The state lives in archive-view.
      import { archive } from '../data/archive';
      import { createArchiveView, type Chip, type Row } from '../lib/archive-view';
      import type { EscapeHatch } from '../lib/escape-hatch';

      const archiveView = createArchiveView(archive);

      const heading = document.getElementById('heading')!;
      const countEl = document.getElementById('count')!;
      const results = document.getElementById('results')!;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-chapitre-id], [data-chapitre-reset]'),
      );
      const countrySel = document.getElementById('filter-country') as HTMLSelectElement;
      const brandSel = document.getElementById('filter-brand') as HTMLSelectElement;
      const yearSel = document.getElementById('filter-year') as HTMLSelectElement;
      const resetBtn = document.getElementById('filter-reset') as HTMLButtonElement;
      const sidebar = document.getElementById('sidebar')!;
      const sidebarToggle = document.getElementById('sidebar-toggle') as HTMLButtonElement;
      // Tracks Tailwind's `md` breakpoint (768px); the CSS sheet rule uses the
      // same 767px boundary and the two must stay in lockstep.
      const isMobile = window.matchMedia('(max-width: 767px)');

      function chipElement({ label, primary }: Chip): HTMLElement {
        const el = document.createElement('span');
        el.className = primary ? 'chip chip--primary' : 'chip';
        el.textContent = label;
        return el;
      }

      function rowElement(r: Row): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'result-row';

        const left = document.createElement('div');
        left.className = 'result-row__main';

        const title = document.createElement('div');
        title.className = 'result-row__title';
        title.textContent = r.title;
        left.appendChild(title);

        if (r.meta) {
          const meta = document.createElement('div');
          meta.className = 'result-row__meta';
          meta.append(`${r.meta.flag} ${r.meta.epreuve} · `);
          const year = document.createElement('span');
          year.className = 'tnum';
          year.textContent = r.meta.year;
          meta.appendChild(year);
          left.appendChild(meta);
        }

        const chips = document.createElement('div');
        chips.className = 'result-row__chips';
        chips.append(...r.chips.map(chipElement));
        left.appendChild(chips);

        li.appendChild(left);

        // "Ouvrir" opens the parent paper's PDF at the exercise's start page in
        // a new tab. Omitted entirely when there's no usable path, so a missing
        // pdfPath degrades to no action rather than a broken link.
        if (r.href) {
          const open = document.createElement('a');
          open.className = 'btn btn--primary';
          open.href = r.href;
          open.target = '_blank';
          open.rel = 'noopener noreferrer';
          open.textContent = 'Ouvrir';
          li.appendChild(open);
        }
        return li;
      }

      // A clear "aucun résultat" state, never a blank list, with the one reset
      // archive-view chose (design.md ResultsState).
      function emptyState(escape: EscapeHatch | null): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'empty-state';

        const art = document.createElement('img');
        art.className = 'empty-state__art';
        art.src = '/empty-state.png';
        art.alt = '';
        art.width = 192;
        art.height = 206;
        li.appendChild(art);

        const title = document.createElement('p');
        title.className = 'empty-state__title';
        title.textContent = 'Aucun résultat';
        li.appendChild(title);

        const hint = document.createElement('p');
        hint.className = 'empty-state__hint';
        hint.textContent = 'Aucun exercice ne correspond à ces filtres.';
        li.appendChild(hint);

        if (escape) {
          const reset = document.createElement('button');
          reset.type = 'button';
          reset.className = 'btn btn--secondary empty-state__reset';
          reset.textContent = escape.label;
          reset.addEventListener(
            'click',
            command(() =>
              escape.kind === 'clear-refinements' ? archiveView.clearRefinements() : archiveView.showAll(),
            ),
          );
          li.appendChild(reset);
        }
        return li;
      }

      function paint(): void {
        const v = archiveView.view();
        heading.textContent = v.heading;
        countEl.textContent = v.count;
        for (const b of buttons) {
          b.setAttribute('aria-pressed', String((b.dataset.chapitreId ?? null) === v.pressedChapitreId));
        }
        countrySel.value = v.refinements.country;
        brandSel.value = v.refinements.examBrand;
        yearSel.value = v.refinements.year;
        sidebar.dataset.open = String(v.sheetOpen);
        sidebarToggle.setAttribute('aria-expanded', String(v.sheetOpen));
        results.replaceChildren(
          ...(v.results.kind === 'rows' ? v.results.rows.map(rowElement) : [emptyState(v.results.escape)]),
        );
      }

      // Wrap a command so the page repaints after it runs.
      function command(run: () => void): () => void {
        return () => {
          run();
          paint();
        };
      }

      for (const btn of buttons) {
        btn.addEventListener('click', command(() => archiveView.selectChapitre(btn.dataset.chapitreId)));
      }
      countrySel.addEventListener('change', command(() => archiveView.refine({ country: countrySel.value })));
      brandSel.addEventListener('change', command(() => archiveView.refine({ examBrand: brandSel.value })));
      yearSel.addEventListener('change', command(() => archiveView.refine({ year: yearSel.value })));
      resetBtn.addEventListener('click', command(() => archiveView.clearRefinements()));
      sidebarToggle.addEventListener('click', command(() => archiveView.toggleSheet()));

      const reportViewport = () => archiveView.setViewport(isMobile.matches ? 'mobile' : 'desktop');
      isMobile.addEventListener('change', reportViewport);
      reportViewport();

      // A reload or back/forward can restore the selects' values — before this
      // script runs in some browsers, after it in others (Chrome). Adopt them
      // as the student's refinements now and again on pageshow, which fires
      // once restoration is done, so the selects and the results never disagree.
      const adoptSelects = () =>
        archiveView.refine({ country: countrySel.value, examBrand: brandSel.value, year: yearSel.value });
      adoptSelects();
      window.addEventListener('pageshow', command(adoptSelects));

      paint();
    </script>
  </body>
</html>
