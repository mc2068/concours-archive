---
import '../styles/global.css';
import { dataset } from '../data/dataset';
import { FLAGS } from '../lib/format';
import type { Country } from '../lib/types';

const chapitres = [...dataset.chapitres].sort((a, b) => a.order - b.order);
const domains = [...new Set(chapitres.map((c) => c.domain))];

// Refinement options, derived from the papers actually in the dataset so the
// controls only ever offer values that can return a result.
const COUNTRY_LABELS: Record<Country, string> = { FR: 'France', TN: 'Tunisie', MA: 'Maroc' };
const presentCountries = new Set(dataset.papers.map((p) => p.country));
const countries = (Object.keys(COUNTRY_LABELS) as Country[])
  .filter((code) => presentCountries.has(code))
  .map((code) => ({ code, label: COUNTRY_LABELS[code] }));
const examBrands = [...new Set(dataset.papers.map((p) => p.examBrand))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
const years = [...new Set(dataset.papers.map((p) => p.year))].sort((a, b) => b - a);

// Masthead facts. Counted off the dataset so they can never drift from what the
// archive actually holds.
const exerciseTotal = dataset.exercises.length;
const paperTotal = dataset.papers.length;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Archive d'exercices de concours (2ème prépa MP) filtrables par chapitre."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Concours archive — exercices de concours par chapitre</title>
  </head>
  <body class="flex min-h-screen flex-col bg-surface font-sans text-ink antialiased">
    <header class="masthead">
      <div class="masthead__inner mx-auto max-w-6xl px-4 py-5 md:py-6">
        <div class="masthead__brand">
          <img class="masthead__mark" src="/logo.png" alt="" width="40" height="40" />
          <div class="min-w-0">
            <h1 class="masthead__title">Concours archive</h1>
            <p class="masthead__tagline">
              Exercices de concours classés par chapitre — programme tunisien 2ème prépa MP
            </p>
          </div>
        </div>
        <dl class="masthead__stats">
          <div>
            <dd class="masthead__stat-value">{exerciseTotal}</dd>
            <dt class="masthead__stat-label">Exercices</dt>
          </div>
          <div>
            <dd class="masthead__stat-value">{paperTotal}</dd>
            <dt class="masthead__stat-label">Épreuves</dt>
          </div>
        </dl>
      </div>
    </header>

    <div class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 md:py-8">
      <!-- Mobile only: the sidebar collapses into a sheet behind this toggle -->
      <button
        type="button"
        id="sidebar-toggle"
        class="btn btn--secondary sidebar-toggle mb-4"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        Chapitres &amp; filtres
      </button>

      <div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-8">
        <!-- Sidebar: the chapitre front door (a collapsible sheet on mobile) -->
        <aside
          id="sidebar"
          class="sidebar panel w-full shrink-0 p-4 md:w-72"
          data-open="false"
          aria-label="Chapitres et filtres"
        >
          <nav aria-label="Chapitres">
          <button type="button" class="chapitre-btn" data-chapitre-reset aria-pressed="true">
            Tous les chapitres
          </button>
          {
            domains.map((domain) => (
              <div class="mt-6">
                <p class="domain-label">{domain}</p>
                <div class="mt-2 flex flex-col gap-1">
                  {chapitres
                    .filter((c) => c.domain === domain)
                    .map((c) => (
                      <button
                        type="button"
                        class="chapitre-btn"
                        data-chapitre-id={c.id}
                        aria-pressed="false"
                      >
                        {c.name}
                      </button>
                    ))}
                </div>
              </div>
            ))
          }
        </nav>

        <!-- Refinement filters: stackable AND on top of the chapitre -->
        <div class="filter-bar" role="group" aria-label="Filtres">
          <p class="domain-label">Affiner</p>
          <div class="filter-field">
            <label for="filter-country">Pays</label>
            <select id="filter-country" class="filter-select">
              <option value="">Tous</option>
              {countries.map((c) => <option value={c.code}>{FLAGS[c.code]} {c.label}</option>)}
            </select>
          </div>
          <div class="filter-field">
            <label for="filter-brand">Concours</label>
            <select id="filter-brand" class="filter-select">
              <option value="">Tous</option>
              {examBrands.map((b) => <option value={b}>{b}</option>)}
            </select>
          </div>
          <div class="filter-field">
            <label for="filter-year">Année</label>
            <select id="filter-year" class="filter-select">
              <option value="">Toutes</option>
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>
          <button type="button" id="filter-reset" class="filter-reset">
            Réinitialiser les filtres
          </button>
        </div>
      </aside>

      <!-- Main column: results -->
      <main class="min-w-0 flex-1">
        <section class="panel overflow-hidden">
          <div class="panel__header">
            <h2 id="heading" class="panel__title">Tous les exercices</h2>
            <p id="count" class="panel__count"></p>
          </div>
          <ul id="results"></ul>
          <noscript>
            <p class="empty-state">Ce site a besoin de JavaScript pour filtrer les exercices.</p>
          </noscript>
        </section>
      </main>
      </div>
    </div>

    <footer class="site-footer">
      <div class="mx-auto max-w-6xl px-4 py-6">
        Concours archive — archives des concours de France, Tunisie et Maroc,
        remises dans les chapitres du programme tunisien MP.
      </div>
    </footer>

    <script>
      import { dataset } from '../data/dataset';
      import { filterExercises } from '../lib/filter';
      import { FLAGS, exerciseCount, paperEpreuve } from '../lib/format';
      import { pdfHref } from '../lib/pdf';
      import type { Country, Exercise, FilterCriteria } from '../lib/types';

      const chapitreById = new Map(dataset.chapitres.map((c) => [c.id, c]));
      const paperById = new Map(dataset.papers.map((p) => [p.id, p]));

      const heading = document.getElementById('heading')!;
      const countEl = document.getElementById('count')!;
      const results = document.getElementById('results')!;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-chapitre-id], [data-chapitre-reset]'),
      );
      const countrySel = document.getElementById('filter-country') as HTMLSelectElement;
      const brandSel = document.getElementById('filter-brand') as HTMLSelectElement;
      const yearSel = document.getElementById('filter-year') as HTMLSelectElement;
      const resetBtn = document.getElementById('filter-reset') as HTMLButtonElement;
      const sidebar = document.getElementById('sidebar')!;
      const sidebarToggle = document.getElementById('sidebar-toggle') as HTMLButtonElement;
      const chapitreResetBtn = document.querySelector('[data-chapitre-reset]') as HTMLButtonElement;
      // Tracks Tailwind's `md` breakpoint (768px); the CSS sheet rule uses the
      // same 767px boundary and the two must stay in lockstep.
      const isMobile = window.matchMedia('(max-width: 767px)');

      let selectedChapterId: string | null = null;

      function hasRefinements(): boolean {
        return Boolean(countrySel.value || brandSel.value || yearSel.value);
      }

      // Reset returns to the chapitre-only view: clear refinements, keep the chapitre.
      function clearRefinements(): void {
        countrySel.value = '';
        brandSel.value = '';
        yearSel.value = '';
        render();
      }

      function setSidebarOpen(open: boolean): void {
        sidebar.dataset.open = String(open);
        sidebarToggle.setAttribute('aria-expanded', String(open));
      }

      // Assemble the active criteria from the chapitre front door plus the
      // optional refinement selects; an empty select value means "no constraint".
      function currentCriteria(): FilterCriteria {
        const criteria: FilterCriteria = {};
        if (selectedChapterId) criteria.chapterId = selectedChapterId;
        if (countrySel.value) criteria.country = countrySel.value as Country;
        if (brandSel.value) criteria.examBrand = brandSel.value;
        if (yearSel.value) criteria.year = Number(yearSel.value);
        return criteria;
      }

      function chip(chapterId: string, isPrimary: boolean): HTMLElement {
        const el = document.createElement('span');
        el.className = isPrimary ? 'chip chip--primary' : 'chip';
        el.textContent = chapitreById.get(chapterId)?.name ?? chapterId;
        return el;
      }

      function row(ex: Exercise): HTMLLIElement {
        const paper = paperById.get(ex.paperId);

        const li = document.createElement('li');
        li.className = 'result-row';

        const left = document.createElement('div');
        left.className = 'result-row__main';

        const title = document.createElement('div');
        title.className = 'result-row__title';
        title.textContent = ex.label;
        left.appendChild(title);

        if (paper) {
          const meta = document.createElement('div');
          meta.className = 'result-row__meta';
          meta.append(`${FLAGS[paper.country]} ${paperEpreuve(paper)} · `);
          const year = document.createElement('span');
          year.className = 'tnum';
          year.textContent = String(paper.year);
          meta.appendChild(year);
          left.appendChild(meta);
        }

        const chips = document.createElement('div');
        chips.className = 'result-row__chips';
        for (const id of ex.chapterIds) {
          chips.appendChild(chip(id, id === ex.primaryChapterId));
        }
        left.appendChild(chips);

        li.appendChild(left);

        // "Ouvrir" opens the parent paper's PDF at the exercise's start page in
        // a new tab. Omitted entirely when there's no usable path, so a missing
        // pdfPath degrades to no action rather than a broken link.
        const href = paper ? pdfHref(paper.pdfPath, ex.pageStart) : null;
        if (href) {
          const open = document.createElement('a');
          open.className = 'btn btn--primary';
          open.href = href;
          open.target = '_blank';
          open.rel = 'noopener noreferrer';
          open.textContent = 'Ouvrir';
          li.appendChild(open);
        }
        return li;
      }

      function render(): void {
        const matches = filterExercises(dataset, currentCriteria());

        heading.textContent = selectedChapterId
          ? (chapitreById.get(selectedChapterId)?.name ?? 'Exercices')
          : 'Tous les exercices';
        countEl.textContent = exerciseCount(matches.length);

        results.replaceChildren();
        if (matches.length === 0) {
          results.appendChild(emptyState());
          return;
        }
        for (const ex of matches) results.appendChild(row(ex));
      }

      // A clear "aucun résultat" state, never a blank list. Offers a reset when
      // refinements are what narrowed the list to nothing (design.md ResultsState).
      function emptyState(): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'empty-state';

        const art = document.createElement('img');
        art.className = 'empty-state__art';
        art.src = '/empty-state.png';
        art.alt = '';
        art.width = 72;
        art.height = 72;
        li.appendChild(art);

        const title = document.createElement('p');
        title.className = 'empty-state__title';
        title.textContent = 'Aucun résultat';
        li.appendChild(title);

        const hint = document.createElement('p');
        hint.className = 'empty-state__hint';
        hint.textContent = 'Aucun exercice ne correspond à ces filtres.';
        li.appendChild(hint);

        // Always offer a way out of an empty result: clear the refinements that
        // narrowed it, or — if only a chapitre is selected — widen to all.
        const reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'btn btn--secondary empty-state__reset';
        if (hasRefinements()) {
          reset.textContent = 'Réinitialiser les filtres';
          reset.addEventListener('click', clearRefinements);
          li.appendChild(reset);
        } else if (selectedChapterId) {
          reset.textContent = 'Voir tous les exercices';
          reset.addEventListener('click', () => chapitreResetBtn.click());
          li.appendChild(reset);
        }
        return li;
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          selectedChapterId = btn.dataset.chapitreId ?? null;
          for (const b of buttons) {
            const active = b === btn;
            b.setAttribute('aria-pressed', String(active));
          }
          render();
          // On mobile the sidebar is a collapsible sheet above the results;
          // picking a chapitre closes it so the student lands on the matches.
          if (isMobile.matches) setSidebarOpen(false);
        });
      }

      for (const sel of [countrySel, brandSel, yearSel]) {
        sel.addEventListener('change', render);
      }

      resetBtn.addEventListener('click', clearRefinements);

      sidebarToggle.addEventListener('click', () => {
        setSidebarOpen(sidebar.dataset.open !== 'true');
      });

      render();
    </script>
  </body>
</html>
